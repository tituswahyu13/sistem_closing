# ==============================================================================
# KONFIGURASI SISTEM CLOSING - CONTOH FILE .ENV
# Salin file ini menjadi .env lalu sesuaikan nilai kredensial di server lokal.
# ==============================================================================

# Konfigurasi Database SIMPADU
DB_HOST=192.168.0.10
DB_USER=root
DB_PASS=
DB_NAME=simpadu
PORT=3306

# Konfigurasi Autentikasi dan Sesi Operator
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_PIN=
SESSION_TIMEOUT_MINUTES=60
